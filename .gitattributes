#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# Windows script files: stored as committed, no conversion. Gradle generates
# gradlew.bat with CRLF and Dependabot commits those bytes as-is.
*.bat           -text whitespace=cr-at-eol

# Binary files should be left untouched
*.jar           binary

